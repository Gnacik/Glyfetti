{
  "$schema": "../schema/style.schema.json",
  "name": "flat_ui",
  "order": 12,
  "description": "Clean UI text: dark with a white rim – descriptions, numbers",
  "font": "../fonts/Dosis.ttf",
  "font_label": "Dosis",
  "size": 90,
  "supersample": 3,
  "atlas_width": 2048,
  "tracking": 0,
  "line_height": 1.05,
  "condense": 1.0,
  "embolden": 0,
  "chars": "ABCDEFGHIJKLMNOPQRSTUVWXYZĄĆĘŁŃÓŚŹŻabcdefghijklmnopqrstuvwxyząćęłńóśźż0123456789!?.,:;%+-–×*/\\#'\"=()[]{}<>&@_~^$€…«»„”“",
  "fill": {
